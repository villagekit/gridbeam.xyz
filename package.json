{
  "name": "gridbeam.xyz",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "EUPL-1.2",
  "packageManager": "pnpm@9.9.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev --turbopack",
    "predev": "node scripts/generate-designs-data.mjs",
    "build": "next build --turbopack",
    "prebuild": "node scripts/generate-designs-data.mjs",
    "start": "next start",
    "lint": "biome check .",
    "format": "biome check --apply .",
    "format:unsafe": "biome check --apply-unsafe .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "generate:designs": "node scripts/generate-designs-data.mjs",
    "audit:pages": "node scripts/audit-pages.mjs",
    "audit:dom": "node scripts/audit-dom.mjs",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build"
  },
  "dependencies": {
    "@chakra-ui/react": "^3.35.0",
    "@emotion/cache": "^11.14.0",
    "@emotion/react": "^11.14.0",
    "@mdx-js/loader": "^3.1.0",
    "@mdx-js/react": "^3.1.0",
    "@next/mdx": "^15.5.0",
    "@opennextjs/cloudflare": "^1.19.11",
    "@react-three/fiber": "^9.0.0",
    "@villagekit/parameters": "^0.10.0",
    "@villagekit/part": "^0.10.0",
    "@villagekit/part-fastener": "^0.10.0",
    "@villagekit/part-gridbeam": "^0.10.0",
    "@villagekit/part-gridpanel": "^0.10.0",
    "@villagekit/plugin-smart-fasteners": "^0.10.0",
    "@villagekit/product": "^0.10.0",
    "@villagekit/product-kit": "^0.10.0",
    "@villagekit/sandbox": "^0.10.0",
    "@villagekit/ui": "^1.2.0",
    "@xstate/react": "^6.0.0",
    "motion": "^12.38.0",
    "next": "^15.5.18",
    "pluralize-esm": "^9.0.5",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-icons": "^5.2.1",
    "smol-toml": "^1.3.0",
    "three": "^0.165.0",
    "xstate": "^5.13.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.8.0",
    "@types/mdx": "^2.0.13",
    "@types/node": "^22.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/three": "^0.165.0",
    "playwright": "^1.60.0",
    "typescript": "^5.5.0",
    "vitest": "^4.1.11",
    "wrangler": "^4.93.0"
  },
  "pnpm": {
    "overrides": {
      "@types/react": "^19.1.0",
      "@types/react-dom": "^19.1.0"
    }
  }
}
